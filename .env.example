# A free key is required for cursor paging after the first page and recommended
# for any non-trivial collection. Create one at https://openalex.org/settings/api
OPENALEX_API_KEY=

# Optional, used only in the descriptive User-Agent (never sent as a query filter).
OPENALEX_CONTACT_EMAIL=

# Optional for the isolated RQ7 Crossref metadata pilot. Crossref Polite API
# accepts this as a `mailto` parameter; no Crossref API key is required.
CROSSREF_EMAIL=
