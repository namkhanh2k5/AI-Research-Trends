0\u0430\u0444\u0438\u044f\u0434\u0430 \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440 \u0440\u0435\u0442\u0456\u043d\u0434\u0435 \u049b\u043e\u043b\u0434\u0430\u043d\u044b\u043b\u0430\u0442\u044b\u043d: \u043c\u04d9\u0442\u0456\u043d, \u0441\u0443\u0440\u0435\u0442, \u0430\u0443\u0434\u0438\u043e\/\u0432\u0438\u0434\u043e \u0444\u0430\u0439\u043b\u0434\u0430\u0440 \u0436\u04d9\u043d\u0435 \u0445\u0430\u0442\u0442\u0430\u043c\u0430\u043b\u0430\u0440 \u049b\u0430\u0440\u0430\u0441\u0442\u044b\u0440\u044b\u043b\u0434\u044b.\u00a0 \u0416\u0430\u0441\u044b\u0440\u044b\u043d \u0430\u049b\u043f\u0430\u0440\u0430\u0442\u0442\u0430\u0440\u0434\u044b \u0436\u0456\u0431\u0435\u0440\u0443 \u0431\u0430\u0440\u044b\u0441\u044b\u043d\u0434\u0430 \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440 \u0440\u0435\u0442\u0456\u043d\u0434\u0435 \u2013 \u0441\u0443\u0440\u0435\u0442\u0442\u0435\u0440 \u049b\u043e\u043b\u0434\u0430\u043d\u044b\u043b\u0434\u044b.\u00a0 \u0421\u0443\u0440\u0435\u0442\u0442\u0435\u0440 \u0441\u0442\u0435\u0433\u0430\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0441\u0430\u043b\u0430\u0441\u044b\u043d\u0434\u0430 \u0435\u04a3 \u043a\u04e9\u043f \u049b\u043e\u043b\u0434\u0430\u043d\u044b\u0441\u049b\u0430 \u0438\u0435 \u043e\u0431\u044a\u0435\u043a\u0442 \u0440\u0435\u0442\u0456\u043d\u0434\u0435 \u0431\u0435\u043b\u0433\u0456\u043b\u0456 \u0431\u043e\u043b\u0493\u0430\u043d\u0434\u044b\u049b\u0442\u0430\u043d, \u043e\u0441\u044b \u043c\u0430\u049b\u0430\u043b\u0430\u0434\u0430 \u0442\u0430\u0493\u044b \u0434\u0430 \u0431\u0456\u0440 \u0440\u0435\u0442 \u043e\u043d\u044b\u04a3 \u0442\u0438\u0456\u043c\u0434\u0456 \u0435\u043a\u0435\u043d\u0456\u043d \u0430\u043d\u044b\u049b\u0442\u0430\u0434\u044b\u049b.&#x0D;\n\u0416\u04b1\u043c\u044b\u0441\u0442\u044b\u04a3 \u043c\u0430\u049b\u0441\u0430\u0442\u044b: \u0436\u0430\u0441\u044b\u0440\u044b\u043d \u0430\u049b\u043f\u0430\u0440\u0430\u0442\u0442\u0430\u0440\u0434\u044b \u0430\u0440\u043d\u0430\u043b\u0430\u0440 \u0430\u0440\u049b\u044b\u043b\u044b \u0431\u0435\u0440\u0443 \u0442\u04d9\u0441\u0456\u043b\u0434\u0435\u0440\u0456\u043d \u0431\u0438\u043a\u0443\u0431\u0442\u0456\u043a \u0438\u043d\u0442\u0435\u0440\u043f\u043e\u043b\u044f\u0446\u0438\u044f\u043d\u044b\u04a3 \u043a\u04e9\u043c\u0435\u0433\u0456\u043c\u0435\u043d \u043e\u0440\u044b\u043d\u0434\u0430\u0443 \u0436\u04d9\u043d\u0435 \u043e\u0493\u0430\u043d \u0441\u0442\u0435\u0433\u043e\u0442\u0430\u043b\u0434\u0430\u0443 \u0436\u04af\u0440\u0433\u0456\u0437\u0443 \u0436\u043e\u043b\u0434\u0430\u0440\u044b\u043d\u0430 \u0442\u0430\u043b\u0434\u0430\u0443 \u0436\u0430\u0441\u0430\u0443 \u0431\u043e\u043b\u044b\u043f \u0442\u0430\u0431\u044b\u043b\u0434\u044b. \u041c\u0430\u049b\u0441\u0430\u0442\u049b\u0430 \u0436\u0435\u0442\u0443 \u04af\u0448\u0456\u043d \u043c\u0430\u049b\u0430\u043b\u0430\u0434\u0430 \u0441\u0442\u0435\u0433\u0430\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f\u043b\u044b\u049b \u04af\u0448 \u04d9\u0434\u0456\u0441 \u049b\u0430\u0440\u0430\u0441\u0442\u044b\u0440\u044b\u043b\u0434\u044b. \u0418\u043d\u0442\u0435\u0440\u043f\u043e\u043b\u044f\u0446\u0438\u044f\u043d\u044b\u04a3 \u0431\u0438\u043a\u0443\u0431\u0442\u0456\u043a \u0434\u0435\u043f \u0430\u0442\u0430\u043b\u0430\u0442\u044b\u043d \u0442\u04af\u0440\u0456\u043d \u043f\u0430\u0439\u0434\u0430\u043b\u0430\u043d\u0430 \u043e\u0442\u044b\u0440\u044b\u043f, \u0430\u0440\u043d\u0430\u0439\u044b \u0436\u0430\u0441\u044b\u0440\u044b\u043d \u0430\u049b\u043f\u0430\u0440\u0430\u0442\u0442\u044b \u0435\u043d\u0433\u0456\u0437\u0443 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0456\u043d \u049b\u043e\u043b\u0434\u0430\u043d\u044b\u043f, Phyton \u0442\u0456\u043b\u0456\u043d\u0434\u0435 \u0431\u0430\u0493\u0434\u0430\u0440\u043b\u0430\u043c\u0430 \u0436\u0430\u0437\u044b\u043b\u044b\u043f, \u04e9\u0437 \u043a\u0435\u0437\u0435\u0433\u0456\u043d\u0434\u0435 300 \u0434\u0430\u043d\u0430 \u0441\u0443\u0440\u0435\u0442\u0442\u0435\u0440 \u0442\u0435\u0441\u0442\u0442\u0435\u043d \u04e9\u0442\u043a\u0456\u0437\u0456\u043b\u0434\u0456. \u0411\u043e\u0441 \u0436\u04d9\u043d\u0435 \u0436\u0430\u0441\u044b\u0440\u044b\u043d \u0430\u049b\u043f\u0430\u0440\u0430\u0442\u044b \u0431\u0430\u0440 \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440\u043b\u0435\u0440 RS \u0441\u0442\u0435\u0433\u043e\u0442\u0430\u043b\u0434\u0430\u0443\u044b\u043d\u044b\u04a3 \u043a\u04e9\u043c\u0435\u0433\u0456\u043c\u0435\u043d \u049b\u0430\u043d\u0448\u0430\u043b\u044b\u049b\u0442\u044b \u0436\u0430\u0441\u044b\u0440\u044b\u043d \u0442\u04af\u0440\u0434\u0435 \u0431\u043e\u043b\u0443\u044b \u043c\u04af\u043c\u043a\u0456\u043d \u0435\u043a\u0435\u043d\u0434\u0456\u043a\u0442\u0435\u0440\u0456 \u0437\u0435\u0440\u0442\u0442\u0435\u043b\u0434\u0456 \u0436\u04d9\u043d\u0435 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442 \u0442\u04af\u0440\u0456\u043d\u0434\u0435 \u0436\u0430\u0441\u0430\u043b\u044b\u043f, \u0442\u0438\u0456\u0441\u0442\u0456 \u043d\u04d9\u0442\u0438\u0436\u0435\u043b\u0435\u0440 \u0430\u043b\u044b\u043d\u0434\u044b.&#x0D;\n\u0421\u043e\u043d\u044b\u043c\u0435\u043d \u049b\u0430\u0442\u0430\u0440, \u0436\u04b1\u043c\u044b\u0441\u0442\u0430 \u049b\u043e\u043b\u0434\u0430\u043d\u044b\u043b\u0493\u0430\u043d \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440\u043b\u0435\u0440\u0434\u0456\u04a3 \u0435\u043a\u0456 \u0442\u04af\u0440\u0456\u043d\u0456\u04a3, \u044f\u0493\u043d\u0438 \u0431\u043e\u0441 \u0436\u04d9\u043d\u0435 \u0436\u0430\u0441\u044b\u0440\u044b\u043d \u0430\u049b\u043f\u0430\u0440\u0430\u0442\u0442\u0430\u0440\u044b \u0431\u0430\u0440 \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440\u043b\u0435\u0440 \u043a\u04e9\u043b\u0435\u043c\u0456 \u043a\u0435\u0437\u0434\u0435\u0439\u0441\u043e\u049b \u0442\u04af\u0440\u0434\u0435 \u0442\u0430\u04a3\u0434\u0430\u043b\u044b\u043d\u0493\u0430\u043d \u0430\u0440\u0445\u0438\u0432\u0442\u0435\u0443 \u0431\u0430\u0493\u0434\u0430\u0440\u043b\u0430\u043c\u0430\u043b\u0430\u0440\u044b\u043d\u044b\u04a3 \u043a\u04e9\u043c\u0435\u0433\u0456\u043c\u0435\u043d \u0441\u0430\u043b\u044b\u0441\u0442\u044b\u0440\u044b\u043b\u0434\u044b \u0436\u04d9\u043d\u0435 \u0430\u043b\u044b\u043d\u0493\u0430\u043d \u043d\u04d9\u0442\u0438\u0436\u0435\u043b\u0435\u0440 \u049b\u043e\u0439\u044b\u043b\u0493\u0430\u043d \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0442\u0456\u04a3 \u0434\u04b1\u0440\u044b\u0441\u0442\u044b\u0493\u044b\u043d \u0434\u04d9\u043b\u0435\u043b\u0434\u0435\u0439 \u0442\u04af\u0441\u0442\u0456. \u0410\u043b\u044b\u043d\u0493\u0430\u043d \u043d\u04d9\u0442\u0438\u0436\u0435\u043b\u0435\u0440 \u0437\u0435\u0440\u0442\u0442\u0435\u0443 \u0431\u0430\u0440\u044b\u0441\u044b\u043d\u0434\u0430 \u043f\u0430\u0439\u0434\u0430\u043b\u0430\u043d\u044b\u043b\u0493\u0430\u043d \u0436\u04b1\u043c\u044b\u0441 \u043d\u04d9\u0442\u0438\u0436\u0435\u043b\u0435\u0440\u0456\u043c\u0435\u043d \u0441\u0430\u043b\u044b\u0441\u0442\u044b\u0440\u044b\u043b\u0434\u044b. \u0421\u0442\u0435\u0433\u0430\u043d\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0431\u0430\u0493\u044b\u0442\u044b\u043d\u0434\u0430 \u0438\u043d\u0442\u0435\u0440\u043f\u043e\u043b\u044f\u0446\u0438\u044f\u043d\u044b\u04a3 \u0431\u0430\u0441\u049b\u0430 \u0434\u0430 \u0442\u04af\u0440\u043b\u0435\u0440\u0456\u043d \u043f\u0430\u0439\u0434\u0430\u043b\u0430\u043d \u043e\u0442\u044b\u0440\u044b\u043f, \u0431\u043e\u043b\u0430\u0448\u0430\u049b\u0442\u0430 \u0431\u0430\u0441\u049b\u0430 \u0434\u0430 \u0437\u0435\u0440\u0442\u0442\u0435\u0443\u043b\u0435\u0440 \u0436\u0430\u0441\u0430\u0443 \u0436\u043e\u0441\u043f\u0430\u0440\u0434\u0430 \u0431\u0430\u0440.<\/jats:p>","DOI":"10.52167\/1609-1817-2022-122-3-376-383","type":"journal-article","created":{"date-parts":[[2022,11,3]],"date-time":"2022-11-03T09:21:07Z","timestamp":1667467267000},"page":"376-383","source":"Crossref","is-referenced-by-count":0,"title":["\u0418\u041d\u042